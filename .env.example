# Supabase（プロジェクト設定 > API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# アプリの公開 URL（サーバーからの自 API 呼び出し・OAuth リダイレクト先に使用）
APP_BASE_URL=

# TypeSafe（jev）API キー。サーバー側のみで使用し、ブラウザへは出さない
TYPESAFE_API_KEY=

# ローカル Supabase（supabase start）で Google OAuth を使う場合のみ
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
